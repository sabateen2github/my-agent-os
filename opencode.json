{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "default_agent": "orchestrator",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-chat": {},
        "deepseek-reasoner": {},
        "deepseek-v4-flash": {},
        "deepseek-v4-pro": {}
      }
    },
    "crofai": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://crof.ai/v1"
      },
      "models": {
        "glm-5.1-precision": {},
        "deepseek-v3.2": {}
      }
    },
    "google": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai",
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-2.5-flash": {
          "attachment": true
        },
        "gemini-2.5-pro": {
          "attachment": true
        }
      }
    }
  },
  "mcp": {
    "server-brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    }
  },
  "permission": {
    "skill": {
      "browser-agent": "allow",
      "browser-telemetry": "allow"
    },
    "external_directory": {
      "/tmp/opencode/*": "allow",
      "/tmp/ui-state.png": "allow",
      "/home/ubuntu/my-agent-os/skills/*": "allow"
    },
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow"
  }
}
