{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "default_agent": "orchestrator",
  "small_model": "deepseek/deepseek-v4-flash",

  "instructions": [
    "README.md",
    "skills/browser-agent/SKILL.md",
    "skills/self-enhance/SKILL.md"
  ],

  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "timeout": 600000
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 384000
          },
          "options": {
            "reasoningEffort": "max"
          },
          "extra_body": {
            "thinking": {
              "type": "enabled"
            }
          }
        },
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 1048576,
            "output": 384000
          },
          "options": {
            "reasoningEffort": "max"
          },
          "extra_body": {
            "thinking": {
              "type": "enabled"
            }
          }
        }
      }
    },
    "crofai": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://crof.ai/v1"
      },
      "models": {
        "glm-5.1-precision": {},
        "deepseek-v3.2": {}
      }
    },
    "google": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai",
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-2.5-flash": {
          "attachment": true
        },
        "gemini-2.5-pro": {
          "attachment": true
        }
      }
    }
  },

  "agent": {
    "build": {
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.0,
      "maxTokens": 384000
    },
    "plan": {
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.0,
      "maxTokens": 384000
    },
    "general": {
      "model": "deepseek/deepseek-v4-pro",
      "maxTokens": 384000
    },
    "explore": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "title": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "compaction": {
      "model": "deepseek/deepseek-v4-flash"
    }
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "formatter": true,
  "lsp": true,

  "mcp": {
    "server-brave-search": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    }
  },

  "permission": {
    "skill": {
      "browser-agent": "allow",
      "browser-telemetry": "allow",
      "self-enhance": "allow"
    },
    "external_directory": {
      "/tmp/opencode/*": "allow",
      "/tmp/ui-state.png": "allow",
      "/home/ubuntu/my-agent-os/skills/*": "allow"
    },
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow"
  }
}
